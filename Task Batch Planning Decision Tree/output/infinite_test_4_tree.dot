digraph PlanningTree {
  rankdir=TB;
  node [shape=box, style=filled, fontname=Arial, fontsize=10];
  edge [fontname=Arial, fontsize=9];

  node_0 [label="Node 0\nNBA: 0, TS: 1\nProgress: SUF\nMax Time: 17\nBatch: 0\nRobots: [0,0,0,0,1,0]", fillcolor="#E6F3FF"];
  node_1 [label="Node 1\nNBA: 0, TS: 1\nProgress: TRA\nMax Time: 17\nBatch: 0\nRobots: [0,1,0,0,0,0]", fillcolor="#FFFFCC"];
  node_2 [label="Node 2\nNBA: 0, TS: 0\nProgress: PRE\nMax Time: 0\nBatch: 0\nRobots: [0,0,0,0,0,0]", fillcolor="#FFE6E6"];

  node_1 -> node_0 [label="cost=17"];
  node_2 -> node_1 [label="cost=17"];
}
