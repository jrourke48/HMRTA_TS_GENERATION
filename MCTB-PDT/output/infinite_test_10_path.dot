digraph ComprehensiveOptimalPath {
  rankdir=TB;
  concentrate=true;
  node [fontname=Arial];
  edge [fontname=Arial, fontsize=9];

  subgraph cluster_environment {
    label="Environment & Gridworld";
    style=filled;
    fillcolor="#F0F0F0";
    color=black;

    env_info [shape=box, label="GridWorld: 21x21\nTotal States: 6\nInitial State: 0\n", fillcolor="#E8F4F8"];

    env_tasks [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3"><B>Task Locations</B></TD></TR>
        <TR><TD><B>State ID</B></TD><TD><B>Position</B></TD><TD><B>Type</B></TD></TR>
        <TR><TD>0</TD><TD>(18,14)</TD><TD>Task</TD></TR>
        <TR><TD>1</TD><TD>(18,4)</TD><TD>Task</TD></TR>
        <TR><TD>2</TD><TD>(10,10)</TD><TD>Task</TD></TR>
        <TR><TD>3</TD><TD>(5,3)</TD><TD>Task</TD></TR>
        <TR><TD>4</TD><TD>(5,10)</TD><TD>Task</TD></TR>
        <TR><TD>5</TD><TD>(5,15)</TD><TD>Task</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_robots {
    label="Robot Team & Capabilities";
    style=filled;
    fillcolor="#F0F8F0";
    color=black;

    team_info [shape=box, label="Team Size: 6 robots\n", fillcolor="#E8F8E8"];

    robot_caps [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3"><B>Robot Capabilities</B></TD></TR>
        <TR><TD><B>Robot ID</B></TD><TD><B>Name</B></TD><TD><B>Capabilities</B></TD></TR>
        <TR><TD>R1</TD><TD>Rover_1</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R2</TD><TD>Rover_2</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R3</TD><TD>Rover_3</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R4</TD><TD>Rover_4</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R5</TD><TD>Rover_5</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R6</TD><TD>Rover_6</TD><TD>Sensor_Camera</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_ltl {
    label="LTL Formula & Task Constraints";
    style=filled;
    fillcolor="#F8F0F0";
    color=black;

    ltl_info [shape=box, label="LTL Formula Details:\nAutomaton States: 38\nAccepting States: 4\n\n--- LTL FORMULA ---\nGFp0 & GF(!p0 U p1) & GFp2 & GF(!p2 U p3) & GF(!p4 U p5) & GF(!p6 U p7) & GF(!p8 U p9) & G(F(!p10 U p11) | F(!p12 U p13)) & GF(p14 & X(p15 & X(p16 & Xp17)))", fillcolor="#F8E8E8"];

    ltl_tasks [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="5"><B>Task Requirements (LTL APs)</B></TD></TR>
        <TR><TD><B>AP ID</B></TD><TD><B>TS Region</B></TD><TD><B>Batch Value</B></TD><TD><B>Type</B></TD><TD><B>Required Capabilities</B></TD></TR>
        <TR><TD>AP0</TD><TD>TS0</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP1</TD><TD>TS1</TD><TD>0</TD><TD>Unrelated</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>AP2</TD><TD>TS2</TD><TD>0</TD><TD>Unrelated</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>AP3</TD><TD>TS3</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP4</TD><TD>TS4</TD><TD>0</TD><TD>Unrelated</TD><TD>Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP5</TD><TD>TS5</TD><TD>0</TD><TD>Unrelated</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>AP6</TD><TD>TS0</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP7</TD><TD>TS1</TD><TD>0</TD><TD>Unrelated</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>AP8</TD><TD>TS2</TD><TD>0</TD><TD>Unrelated</TD><TD>Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP9</TD><TD>TS3</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP10</TD><TD>TS4</TD><TD>0</TD><TD>Unrelated</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>AP11</TD><TD>TS5</TD><TD>0</TD><TD>Unrelated</TD><TD>Sensor_GPS</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_path {
    label="Optimal Execution Path";
    style=filled;
    fillcolor="#FFF8F0";
    color=darkred;
    penwidth=2;

    path_summary [shape=note, label="Optimal Path Summary\nTotal Steps: 26\nFinal Cost: 96\nTotal Execution Time: 236s\n", fillcolor="#FFFFCC", penwidth=2];

    opt_0 [shape=box, label="Step 0\nNBA: 0 | TS: 0\nCost: 0s | Total: 0s\n-----\nAllocated Robots:\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_1 [shape=box, label="Step 1\nNBA: 1 | TS: 3\nCost: 6s | Total: 7s\n-----\nAllocated Robots:\n  R1: 1s\n  R2: 6s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_2 [shape=box, label="Step 2\nNBA: 3 | TS: 2\nCost: 8s | Total: 15s\n-----\nAllocated Robots:\n  R4: 8s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_3 [shape=box, label="Step 3\nNBA: 5 | TS: 3\nCost: 8s | Total: 17s\n-----\nAllocated Robots:\n  R1: 2s\n  R2: 7s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_4 [shape=box, label="Step 4\nNBA: 14 | TS: 4\nCost: 10s | Total: 26s\n-----\nAllocated Robots:\n  R1: 10s\n  R6: 1s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_5 [shape=box, label="Step 5\nNBA: 22 | TS: 5\nCost: 15s | Total: 33s\n-----\nAllocated Robots:\n  R4: 15s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_6 [shape=box, label="Step 6\nNBA: 23 | TS: 5\nCost: 16s | Total: 39s\n-----\nAllocated Robots:\n  R1: 16s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_7 [shape=box, label="Step 7\nNBA: 24 | TS: 1\nCost: 31s | Total: 55s\n-----\nAllocated Robots:\n  R4: 31s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_8 [shape=box, label="Step 8\nNBA: 25 | TS: 3\nCost: 31s | Total: 67s\n-----\nAllocated Robots:\n  R1: 27s\n  R2: 8s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_9 [shape=box, label="Step 9\nNBA: 26 | TS: 2\nCost: 36s | Total: 76s\n-----\nAllocated Robots:\n  R1: 36s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_10 [shape=box, label="Step 10\nNBA: 27 | TS: 1\nCost: 36s | Total: 77s\n-----\nAllocated Robots:\n  R4: 32s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_11 [shape=box, label="Step 11\nNBA: 28 | TS: 5\nCost: 43s | Total: 84s\n-----\nAllocated Robots:\n  R1: 43s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_12 [shape=box, label="Step 12\nNBA: 29 | TS: 0\nCost: 43s | Total: 117s\n-----\nAllocated Robots:\n  R4: 43s\n  R5: 10s\n  R6: 13s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_13 [shape=box, label="Step 13\nNBA: 1 | TS: 3\nCost: 54s | Total: 129s\n-----\nAllocated Robots:\n  R1: 54s\n  R2: 9s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_14 [shape=box, label="Step 14\nNBA: 3 | TS: 2\nCost: 54s | Total: 137s\n-----\nAllocated Robots:\n  R4: 51s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_15 [shape=box, label="Step 15\nNBA: 5 | TS: 3\nCost: 55s | Total: 139s\n-----\nAllocated Robots:\n  R1: 55s\n  R2: 10s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_16 [shape=box, label="Step 16\nNBA: 14 | TS: 4\nCost: 56s | Total: 151s\n-----\nAllocated Robots:\n  R3: 7s\n  R4: 56s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_17 [shape=box, label="Step 17\nNBA: 22 | TS: 5\nCost: 61s | Total: 156s\n-----\nAllocated Robots:\n  R4: 61s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_18 [shape=box, label="Step 18\nNBA: 23 | TS: 5\nCost: 62s | Total: 157s\n-----\nAllocated Robots:\n  R4: 62s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_19 [shape=box, label="Step 19\nNBA: 24 | TS: 1\nCost: 68s | Total: 170s\n-----\nAllocated Robots:\n  R1: 68s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_20 [shape=box, label="Step 20\nNBA: 25 | TS: 3\nCost: 73s | Total: 182s\n-----\nAllocated Robots:\n  R2: 11s\n  R4: 73s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_21 [shape=box, label="Step 21\nNBA: 26 | TS: 2\nCost: 78s | Total: 192s\n-----\nAllocated Robots:\n  R1: 78s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_22 [shape=box, label="Step 22\nNBA: 27 | TS: 1\nCost: 85s | Total: 204s\n-----\nAllocated Robots:\n  R4: 85s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_23 [shape=box, label="Step 23\nNBA: 28 | TS: 5\nCost: 85s | Total: 211s\n-----\nAllocated Robots:\n  R1: 85s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_24 [shape=box, label="Step 24\nNBA: 29 | TS: 0\nCost: 96s | Total: 224s\n-----\nAllocated Robots:\n  R4: 96s\n  R5: 11s\n  R6: 14s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_25 [shape=box, label="Step 25\nNBA: 1 | TS: 3\nCost: 96s | Total: 236s\n-----\nAllocated Robots:\n  R1: 96s\n  R2: 12s\n", fillcolor="#FF6B6B", penwidth=3, color=darkred, fontweight=bold, fontsize=11];

    opt_0 -> opt_1 [label="Δ=6s", penwidth=2, color=darkred];
    opt_1 -> opt_2 [label="Δ=2s", penwidth=2, color=darkred];
    opt_2 -> opt_3 [label="Δ=0s", penwidth=2, color=darkred];
    opt_3 -> opt_4 [label="Δ=2s", penwidth=2, color=darkred];
    opt_4 -> opt_5 [label="Δ=5s", penwidth=2, color=darkred];
    opt_5 -> opt_6 [label="Δ=1s", penwidth=2, color=darkred];
    opt_6 -> opt_7 [label="Δ=15s", penwidth=2, color=darkred];
    opt_7 -> opt_8 [label="Δ=0s", penwidth=2, color=darkred];
    opt_8 -> opt_9 [label="Δ=5s", penwidth=2, color=darkred];
    opt_9 -> opt_10 [label="Δ=0s", penwidth=2, color=darkred];
    opt_10 -> opt_11 [label="Δ=7s", penwidth=2, color=darkred];
    opt_11 -> opt_12 [label="Δ=0s", penwidth=2, color=darkred];
    opt_12 -> opt_13 [label="Δ=11s", penwidth=2, color=darkred];
    opt_13 -> opt_14 [label="Δ=0s", penwidth=2, color=darkred];
    opt_14 -> opt_15 [label="Δ=1s", penwidth=2, color=darkred];
    opt_15 -> opt_16 [label="Δ=1s", penwidth=2, color=darkred];
    opt_16 -> opt_17 [label="Δ=5s", penwidth=2, color=darkred];
    opt_17 -> opt_18 [label="Δ=1s", penwidth=2, color=darkred];
    opt_18 -> opt_19 [label="Δ=6s", penwidth=2, color=darkred];
    opt_19 -> opt_20 [label="Δ=5s", penwidth=2, color=darkred];
    opt_20 -> opt_21 [label="Δ=5s", penwidth=2, color=darkred];
    opt_21 -> opt_22 [label="Δ=7s", penwidth=2, color=darkred];
    opt_22 -> opt_23 [label="Δ=0s", penwidth=2, color=darkred];
    opt_23 -> opt_24 [label="Δ=11s", penwidth=2, color=darkred];
    opt_24 -> opt_25 [label="Δ=0s", penwidth=2, color=darkred];
  }

  // Connections between clusters
  env_info -> path_summary [style=dashed, color=gray, label="tasks"];
  team_info -> path_summary [style=dashed, color=gray, label="robots"];
  ltl_info -> path_summary [style=dashed, color=gray, label="constraints"];

}
