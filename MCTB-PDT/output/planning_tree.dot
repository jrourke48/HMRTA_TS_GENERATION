digraph PlanningTree {
  rankdir=TB;
  node [shape=box, style=filled, fontname=Arial, fontsize=10];
  edge [fontname=Arial, fontsize=9];

  node_0 [label="Node 0\nNBA: 1, TS: 1\nProgress: PRE\nMax Time: 10\nBatch: 0\nRobots: [0,1,0,1,0,0]", fillcolor="#FFE6E6"];
  node_1 [label="Node 1\nNBA: 2, TS: 0\nProgress: PRE\nMax Time: 0\nBatch: 0\nRobots: [0,0,0,0,0,0]", fillcolor="#FFE6E6"];
  node_2 [label="Node 2\nNBA: 3, TS: 2\nProgress: PRE\nMax Time: 8\nBatch: 0\nRobots: [1,1,0,0,0,0]", fillcolor="#FFE6E6"];
  node_3 [label="Node 3\nNBA: 0, TS: 2\nProgress: TRA\nMax Time: 10\nBatch: 0\nRobots: [1,0,0,0,1,0]", fillcolor="#FF6B6B", penwidth=3, color=red];
  node_4 [label="Node 4\nNBA: 0, TS: 1\nProgress: TRA\nMax Time: 11\nBatch: 0\nRobots: [0,0,0,1,1,0]", fillcolor="#FFFFCC"];

  node_0 -> node_3 [label="cost=10"];
  node_1 -> node_0 [label="cost=10"];
  node_1 -> node_2 [label="cost=8"];
  node_2 -> node_4 [label="cost=11"];
}
