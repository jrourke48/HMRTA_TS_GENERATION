digraph ComprehensiveOptimalPath {
  rankdir=TB;
  concentrate=true;
  node [fontname=Arial];
  edge [fontname=Arial, fontsize=9];

  subgraph cluster_environment {
    label="Environment & Gridworld";
    style=filled;
    fillcolor="#F0F0F0";
    color=black;

    env_info [shape=box, label="GridWorld: 21x21\nTotal States: 6\nInitial State: 0\n", fillcolor="#E8F4F8"];

    env_tasks [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3"><B>Task Locations</B></TD></TR>
        <TR><TD><B>State ID</B></TD><TD><B>Position</B></TD><TD><B>Type</B></TD></TR>
        <TR><TD>0</TD><TD>(18,14)</TD><TD>Task</TD></TR>
        <TR><TD>1</TD><TD>(18,4)</TD><TD>Task</TD></TR>
        <TR><TD>2</TD><TD>(10,10)</TD><TD>Task</TD></TR>
        <TR><TD>3</TD><TD>(5,3)</TD><TD>Task</TD></TR>
        <TR><TD>4</TD><TD>(5,10)</TD><TD>Task</TD></TR>
        <TR><TD>5</TD><TD>(5,15)</TD><TD>Task</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_robots {
    label="Robot Team & Capabilities";
    style=filled;
    fillcolor="#F0F8F0";
    color=black;

    team_info [shape=box, label="Team Size: 6 robots\n", fillcolor="#E8F8E8"];

    robot_caps [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3"><B>Robot Capabilities</B></TD></TR>
        <TR><TD><B>Robot ID</B></TD><TD><B>Name</B></TD><TD><B>Capabilities</B></TD></TR>
        <TR><TD>R1</TD><TD>Rover_1</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R2</TD><TD>Rover_2</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R3</TD><TD>Rover_3</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R4</TD><TD>Rover_4</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R5</TD><TD>Rover_5</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R6</TD><TD>Rover_6</TD><TD>Sensor_Camera</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_ltl {
    label="LTL Formula & Task Constraints";
    style=filled;
    fillcolor="#F8F0F0";
    color=black;

    ltl_info [shape=box, label="LTL Formula Details:\nAutomaton States: 9\nAccepting States: 2\n\n--- LTL FORMULA ---\nGF(p0 & X(p1 & Xp2)) & GF(p3 & Fp4)", fillcolor="#F8E8E8"];

    ltl_tasks [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3"><B>Task Requirements (LTL APs)</B></TD></TR>
        <TR><TD><B>AP ID</B></TD><TD><B>Batch Value</B></TD><TD><B>Required Capabilities</B></TD></TR>
        <TR><TD>AP0</TD><TD>0 (Unrelated)</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP1</TD><TD>0 (Unrelated)</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP2</TD><TD>0 (Unrelated)</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP3</TD><TD>0 (Unrelated)</TD><TD>Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP4</TD><TD>0 (Unrelated)</TD><TD>Sensor_Camera, Sensor_GPS</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_path {
    label="Optimal Execution Path";
    style=filled;
    fillcolor="#FFF8F0";
    color=darkred;
    penwidth=2;

    path_summary [shape=note, label="Optimal Path Summary\nTotal Steps: 10\nFinal Cost: 56\nTotal Execution Time: 171s\n", fillcolor="#FFFFCC", penwidth=2];

    opt_0 [shape=box, label="Step 0\nNBA: 0 | TS: 0\nCost: 0s | Total: 0s\n-----\nAllocated Robots:\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_1 [shape=box, label="Step 1\nNBA: 1 | TS: 3\nCost: 16s | Total: 32s\n-----\nAllocated Robots:\n  R4: 16s\n  R6: 16s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_2 [shape=box, label="Step 2\nNBA: 2 | TS: 4\nCost: 16s | Total: 59s\n-----\nAllocated Robots:\n  R1: 13s\n  R3: 14s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_3 [shape=box, label="Step 3\nNBA: 5 | TS: 0\nCost: 26s | Total: 73s\n-----\nAllocated Robots:\n  R1: 26s\n  R2: 1s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_4 [shape=box, label="Step 4\nNBA: 6 | TS: 1\nCost: 29s | Total: 96s\n-----\nAllocated Robots:\n  R2: 11s\n  R4: 29s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_5 [shape=box, label="Step 5\nNBA: 0 | TS: 2\nCost: 34s | Total: 113s\n-----\nAllocated Robots:\n  R1: 34s\n  R5: 9s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_6 [shape=box, label="Step 6\nNBA: 1 | TS: 3\nCost: 41s | Total: 121s\n-----\nAllocated Robots:\n  R1: 41s\n  R6: 17s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_7 [shape=box, label="Step 7\nNBA: 2 | TS: 4\nCost: 44s | Total: 137s\n-----\nAllocated Robots:\n  R3: 15s\n  R4: 44s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_8 [shape=box, label="Step 8\nNBA: 5 | TS: 0\nCost: 56s | Total: 157s\n-----\nAllocated Robots:\n  R4: 56s\n  R5: 17s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_9 [shape=box, label="Step 9\nNBA: 6 | TS: 1\nCost: 56s | Total: 171s\n-----\nAllocated Robots:\n  R1: 54s\n  R2: 12s\n", fillcolor="#FF6B6B", penwidth=3, color=darkred, fontweight=bold, fontsize=11];

    opt_0 -> opt_1 [label="Δ=16s", penwidth=2, color=darkred];
    opt_1 -> opt_2 [label="Δ=0s", penwidth=2, color=darkred];
    opt_2 -> opt_3 [label="Δ=10s", penwidth=2, color=darkred];
    opt_3 -> opt_4 [label="Δ=3s", penwidth=2, color=darkred];
    opt_4 -> opt_5 [label="Δ=5s", penwidth=2, color=darkred];
    opt_5 -> opt_6 [label="Δ=7s", penwidth=2, color=darkred];
    opt_6 -> opt_7 [label="Δ=3s", penwidth=2, color=darkred];
    opt_7 -> opt_8 [label="Δ=12s", penwidth=2, color=darkred];
    opt_8 -> opt_9 [label="Δ=0s", penwidth=2, color=darkred];
  }

  // Connections between clusters
  env_info -> path_summary [style=dashed, color=gray, label="tasks"];
  team_info -> path_summary [style=dashed, color=gray, label="robots"];
  ltl_info -> path_summary [style=dashed, color=gray, label="constraints"];

}
