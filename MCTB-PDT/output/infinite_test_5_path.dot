digraph ComprehensiveOptimalPath {
  rankdir=TB;
  concentrate=true;
  node [fontname=Arial];
  edge [fontname=Arial, fontsize=9];

  subgraph cluster_environment {
    label="Environment & Gridworld";
    style=filled;
    fillcolor="#F0F0F0";
    color=black;

    env_info [shape=box, label="GridWorld: 21x21\nTotal States: 6\nInitial State: 0\n", fillcolor="#E8F4F8"];

    env_tasks [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3"><B>Task Locations</B></TD></TR>
        <TR><TD><B>State ID</B></TD><TD><B>Position</B></TD><TD><B>Type</B></TD></TR>
        <TR><TD>0</TD><TD>(18,14)</TD><TD>Task</TD></TR>
        <TR><TD>1</TD><TD>(18,4)</TD><TD>Task</TD></TR>
        <TR><TD>2</TD><TD>(10,10)</TD><TD>Task</TD></TR>
        <TR><TD>3</TD><TD>(5,3)</TD><TD>Task</TD></TR>
        <TR><TD>4</TD><TD>(5,10)</TD><TD>Task</TD></TR>
        <TR><TD>5</TD><TD>(5,15)</TD><TD>Task</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_robots {
    label="Robot Team & Capabilities";
    style=filled;
    fillcolor="#F0F8F0";
    color=black;

    team_info [shape=box, label="Team Size: 6 robots\n", fillcolor="#E8F8E8"];

    robot_caps [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3"><B>Robot Capabilities</B></TD></TR>
        <TR><TD><B>Robot ID</B></TD><TD><B>Name</B></TD><TD><B>Capabilities</B></TD></TR>
        <TR><TD>R1</TD><TD>Rover_1</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R2</TD><TD>Rover_2</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R3</TD><TD>Rover_3</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R4</TD><TD>Rover_4</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R5</TD><TD>Rover_5</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R6</TD><TD>Rover_6</TD><TD>Sensor_Camera</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_ltl {
    label="LTL Formula & Task Constraints";
    style=filled;
    fillcolor="#F8F0F0";
    color=black;

    ltl_info [shape=box, label="LTL Formula Details:\nAutomaton States: 7\nAccepting States: 1\n", fillcolor="#F8E8E8"];

    ltl_tasks [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3"><B>Task Requirements (LTL APs)</B></TD></TR>
        <TR><TD><B>AP ID</B></TD><TD><B>Batch Value</B></TD><TD><B>Required Capabilities</B></TD></TR>
        <TR><TD>AP0</TD><TD>0 (Unrelated)</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP1</TD><TD>0 (Unrelated)</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP2</TD><TD>0 (Unrelated)</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP3</TD><TD>0 (Unrelated)</TD><TD>Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP4</TD><TD>0 (Unrelated)</TD><TD>Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP5</TD><TD>0 (Unrelated)</TD><TD>Sensor_Camera, Sensor_GPS</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_path {
    label="Optimal Execution Path";
    style=filled;
    fillcolor="#FFF8F0";
    color=darkred;
    penwidth=2;

    path_summary [shape=note, label="Optimal Path Summary\nTotal Steps: 14\nFinal Cost: 60\nTotal Execution Time: 188s\n", fillcolor="#FFFFCC", penwidth=2];

    opt_0 [shape=box, label="Step 0\nNBA: 0 | TS: 0\nCost: 0s | Total: 0s\n-----\nAllocated Robots:\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_1 [shape=box, label="Step 1\nNBA: 2 | TS: 5\nCost: 6s | Total: 11s\n-----\nAllocated Robots:\n  R4: 6s\n  R6: 5s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_2 [shape=box, label="Step 2\nNBA: 3 | TS: 4\nCost: 8s | Total: 26s\n-----\nAllocated Robots:\n  R1: 8s\n  R3: 7s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_3 [shape=box, label="Step 3\nNBA: 4 | TS: 2\nCost: 12s | Total: 33s\n-----\nAllocated Robots:\n  R4: 12s\n  R5: 1s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_4 [shape=box, label="Step 4\nNBA: 5 | TS: 1\nCost: 21s | Total: 47s\n-----\nAllocated Robots:\n  R1: 21s\n  R2: 1s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_5 [shape=box, label="Step 5\nNBA: 6 | TS: 3\nCost: 21s | Total: 61s\n-----\nAllocated Robots:\n  R3: 14s\n  R4: 19s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_6 [shape=box, label="Step 6\nNBA: 0 | TS: 0\nCost: 32s | Total: 80s\n-----\nAllocated Robots:\n  R1: 32s\n  R5: 9s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_7 [shape=box, label="Step 7\nNBA: 2 | TS: 5\nCost: 32s | Total: 93s\n-----\nAllocated Robots:\n  R4: 31s\n  R6: 6s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_8 [shape=box, label="Step 8\nNBA: 3 | TS: 4\nCost: 35s | Total: 102s\n-----\nAllocated Robots:\n  R4: 35s\n  R6: 11s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_9 [shape=box, label="Step 9\nNBA: 4 | TS: 2\nCost: 40s | Total: 120s\n-----\nAllocated Robots:\n  R1: 40s\n  R2: 11s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_10 [shape=box, label="Step 10\nNBA: 5 | TS: 1\nCost: 48s | Total: 143s\n-----\nAllocated Robots:\n  R4: 48s\n  R5: 19s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_11 [shape=box, label="Step 11\nNBA: 6 | TS: 3\nCost: 48s | Total: 151s\n-----\nAllocated Robots:\n  R1: 47s\n  R3: 15s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_12 [shape=box, label="Step 12\nNBA: 0 | TS: 0\nCost: 59s | Total: 170s\n-----\nAllocated Robots:\n  R2: 19s\n  R4: 59s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_13 [shape=box, label="Step 13\nNBA: 2 | TS: 5\nCost: 60s | Total: 188s\n-----\nAllocated Robots:\n  R1: 60s\n  R6: 16s\n", fillcolor="#FF6B6B", penwidth=3, color=darkred, fontweight=bold, fontsize=11];

    opt_0 -> opt_1 [label="Δ=6s", penwidth=2, color=darkred];
    opt_1 -> opt_2 [label="Δ=2s", penwidth=2, color=darkred];
    opt_2 -> opt_3 [label="Δ=4s", penwidth=2, color=darkred];
    opt_3 -> opt_4 [label="Δ=9s", penwidth=2, color=darkred];
    opt_4 -> opt_5 [label="Δ=0s", penwidth=2, color=darkred];
    opt_5 -> opt_6 [label="Δ=11s", penwidth=2, color=darkred];
    opt_6 -> opt_7 [label="Δ=0s", penwidth=2, color=darkred];
    opt_7 -> opt_8 [label="Δ=3s", penwidth=2, color=darkred];
    opt_8 -> opt_9 [label="Δ=5s", penwidth=2, color=darkred];
    opt_9 -> opt_10 [label="Δ=8s", penwidth=2, color=darkred];
    opt_10 -> opt_11 [label="Δ=0s", penwidth=2, color=darkred];
    opt_11 -> opt_12 [label="Δ=11s", penwidth=2, color=darkred];
    opt_12 -> opt_13 [label="Δ=1s", penwidth=2, color=darkred];
  }

  // Connections between clusters
  env_info -> path_summary [style=dashed, color=gray, label="tasks"];
  team_info -> path_summary [style=dashed, color=gray, label="robots"];
  ltl_info -> path_summary [style=dashed, color=gray, label="constraints"];

}
