digraph ComprehensiveOptimalPath {
  rankdir=TB;
  concentrate=true;
  node [fontname=Arial];
  edge [fontname=Arial, fontsize=9];

  subgraph cluster_environment {
    label="Environment & Gridworld";
    style=filled;
    fillcolor="#F0F0F0";
    color=black;

    env_info [shape=box, label="GridWorld: 210x210\nTotal States: 6\nInitial State: 0\n", fillcolor="#E8F4F8"];

    env_tasks [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3"><B>Task Locations</B></TD></TR>
        <TR><TD><B>State ID</B></TD><TD><B>Position</B></TD><TD><B>Type</B></TD></TR>
        <TR><TD>0</TD><TD>(18,14)</TD><TD>Task</TD></TR>
        <TR><TD>1</TD><TD>(18,4)</TD><TD>Task</TD></TR>
        <TR><TD>2</TD><TD>(10,10)</TD><TD>Task</TD></TR>
        <TR><TD>3</TD><TD>(5,3)</TD><TD>Task</TD></TR>
        <TR><TD>4</TD><TD>(5,10)</TD><TD>Task</TD></TR>
        <TR><TD>5</TD><TD>(5,15)</TD><TD>Task</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_robots {
    label="Robot Team & Capabilities";
    style=filled;
    fillcolor="#F0F8F0";
    color=black;

    team_info [shape=box, label="Team Size: 6 robots\n", fillcolor="#E8F8E8"];

    robot_caps [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3"><B>Robot Capabilities</B></TD></TR>
        <TR><TD><B>Robot ID</B></TD><TD><B>Name</B></TD><TD><B>Capabilities</B></TD></TR>
        <TR><TD>R1</TD><TD>Rover_1</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R2</TD><TD>Rover_2</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R3</TD><TD>Rover_3</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R4</TD><TD>Rover_4</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R5</TD><TD>Rover_5</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R6</TD><TD>Rover_6</TD><TD>Sensor_Camera</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_ltl {
    label="LTL Formula & Task Constraints";
    style=filled;
    fillcolor="#F8F0F0";
    color=black;

    ltl_info [shape=box, label="LTL Formula Details:\nAutomaton States: 55\nAccepting States: 8\n\n--- LTL FORMULA ---\nGF(p0 & X(!p1 U p2)) & GFp1 & Fp9 & Fp10 & (!p9 U p10) & Fp11 & (G(F(p4 & Xp0) & GF(p6 & Xp7)) | (GFp3 & GFp5 & GF(p12 & Xp13)))", fillcolor="#F8E8E8"];

    ltl_tasks [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="5"><B>Task Requirements (LTL APs)</B></TD></TR>
        <TR><TD><B>AP ID</B></TD><TD><B>TS Region</B></TD><TD><B>Batch Value</B></TD><TD><B>Type</B></TD><TD><B>Required Capabilities</B></TD></TR>
        <TR><TD>AP0</TD><TD>TS0</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP1</TD><TD>TS1</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP2</TD><TD>TS2</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP3</TD><TD>TS3</TD><TD>0</TD><TD>Unrelated</TD><TD>Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP4</TD><TD>TS4</TD><TD>0</TD><TD>Unrelated</TD><TD>Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP5</TD><TD>TS5</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP6</TD><TD>TS2</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP7</TD><TD>TS4</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP9</TD><TD>TS3</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP10</TD><TD>TS1</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP11</TD><TD>TS2</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP12</TD><TD>TS3</TD><TD>0</TD><TD>Unrelated</TD><TD>Sensor_Camera, Sensor_GPS</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_path {
    label="Optimal Execution Path";
    style=filled;
    fillcolor="#FFF8F0";
    color=darkred;
    penwidth=2;

    path_summary [shape=note, label="Optimal Path Summary\nTotal Steps: 18\nFinal Cost: 53\nTotal Execution Time: 302s\n", fillcolor="#FFFFCC", penwidth=2];

    opt_0 [shape=box, label="Step 0\nNBA: 0 | TS: 0\nCost: 0s | Total: 0s\n-----\nAllocated Robots:\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_1 [shape=box, label="Step 1\nNBA: 7 | TS: 1\nCost: 13s | Total: 26s\n-----\nAllocated Robots:\n  R1: 13s\n  R5: 13s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_2 [shape=box, label="Step 2\nNBA: 5 | TS: 3\nCost: 13s | Total: 40s\n-----\nAllocated Robots:\n  R2: 7s\n  R4: 7s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_3 [shape=box, label="Step 3\nNBA: 2 | TS: 2\nCost: 16s | Total: 74s\n-----\nAllocated Robots:\n  R2: 16s\n  R4: 16s\n  R6: 16s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_4 [shape=box, label="Step 4\nNBA: 9 | TS: 1\nCost: 16s | Total: 76s\n-----\nAllocated Robots:\n  R1: 14s\n  R5: 14s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_5 [shape=box, label="Step 5\nNBA: 10 | TS: 0\nCost: 24s | Total: 94s\n-----\nAllocated Robots:\n  R4: 24s\n  R5: 24s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_6 [shape=box, label="Step 6\nNBA: 23 | TS: 2\nCost: 24s | Total: 112s\n-----\nAllocated Robots:\n  R1: 24s\n  R2: 24s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_7 [shape=box, label="Step 7\nNBA: 25 | TS: 2\nCost: 25s | Total: 114s\n-----\nAllocated Robots:\n  R1: 25s\n  R2: 25s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_8 [shape=box, label="Step 8\nNBA: 45 | TS: 4\nCost: 31s | Total: 157s\n-----\nAllocated Robots:\n  R1: 31s\n  R2: 31s\n  R3: 31s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_9 [shape=box, label="Step 9\nNBA: 47 | TS: 4\nCost: 32s | Total: 174s\n-----\nAllocated Robots:\n  R1: 32s\n  R6: 32s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_10 [shape=box, label="Step 10\nNBA: 2 | TS: 0\nCost: 32s | Total: 176s\n-----\nAllocated Robots:\n  R4: 25s\n  R5: 25s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_11 [shape=box, label="Step 11\nNBA: 9 | TS: 1\nCost: 35s | Total: 196s\n-----\nAllocated Robots:\n  R4: 35s\n  R5: 35s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_12 [shape=box, label="Step 12\nNBA: 10 | TS: 0\nCost: 45s | Total: 223s\n-----\nAllocated Robots:\n  R1: 45s\n  R2: 45s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_13 [shape=box, label="Step 13\nNBA: 23 | TS: 2\nCost: 45s | Total: 243s\n-----\nAllocated Robots:\n  R4: 45s\n  R5: 45s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_14 [shape=box, label="Step 14\nNBA: 25 | TS: 2\nCost: 46s | Total: 245s\n-----\nAllocated Robots:\n  R4: 46s\n  R5: 46s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_15 [shape=box, label="Step 15\nNBA: 45 | TS: 4\nCost: 52s | Total: 278s\n-----\nAllocated Robots:\n  R3: 52s\n  R4: 52s\n  R5: 52s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_16 [shape=box, label="Step 16\nNBA: 47 | TS: 4\nCost: 53s | Total: 300s\n-----\nAllocated Robots:\n  R4: 53s\n  R6: 53s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_17 [shape=box, label="Step 17\nNBA: 2 | TS: 0\nCost: 53s | Total: 302s\n-----\nAllocated Robots:\n  R1: 46s\n  R2: 46s\n", fillcolor="#FF6B6B", penwidth=3, color=darkred, fontweight=bold, fontsize=11];

    opt_0 -> opt_1 [label="Δ=13s", penwidth=2, color=darkred];
    opt_1 -> opt_2 [label="Δ=0s", penwidth=2, color=darkred];
    opt_2 -> opt_3 [label="Δ=3s", penwidth=2, color=darkred];
    opt_3 -> opt_4 [label="Δ=0s", penwidth=2, color=darkred];
    opt_4 -> opt_5 [label="Δ=8s", penwidth=2, color=darkred];
    opt_5 -> opt_6 [label="Δ=0s", penwidth=2, color=darkred];
    opt_6 -> opt_7 [label="Δ=1s", penwidth=2, color=darkred];
    opt_7 -> opt_8 [label="Δ=6s", penwidth=2, color=darkred];
    opt_8 -> opt_9 [label="Δ=1s", penwidth=2, color=darkred];
    opt_9 -> opt_10 [label="Δ=0s", penwidth=2, color=darkred];
    opt_10 -> opt_11 [label="Δ=3s", penwidth=2, color=darkred];
    opt_11 -> opt_12 [label="Δ=10s", penwidth=2, color=darkred];
    opt_12 -> opt_13 [label="Δ=0s", penwidth=2, color=darkred];
    opt_13 -> opt_14 [label="Δ=1s", penwidth=2, color=darkred];
    opt_14 -> opt_15 [label="Δ=6s", penwidth=2, color=darkred];
    opt_15 -> opt_16 [label="Δ=1s", penwidth=2, color=darkred];
    opt_16 -> opt_17 [label="Δ=0s", penwidth=2, color=darkred];
  }

  // Connections between clusters
  env_info -> path_summary [style=dashed, color=gray, label="tasks"];
  team_info -> path_summary [style=dashed, color=gray, label="robots"];
  ltl_info -> path_summary [style=dashed, color=gray, label="constraints"];

}
