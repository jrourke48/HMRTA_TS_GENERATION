digraph ComprehensiveOptimalPath {
  rankdir=TB;
  concentrate=true;
  node [fontname=Arial];
  edge [fontname=Arial, fontsize=9];

  subgraph cluster_environment {
    label="Environment & Gridworld";
    style=filled;
    fillcolor="#F0F0F0";
    color=black;

    env_info [shape=box, label="GridWorld: 210x210\nTotal States: 6\nInitial State: 0\n", fillcolor="#E8F4F8"];

    env_tasks [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3"><B>Task Locations</B></TD></TR>
        <TR><TD><B>State ID</B></TD><TD><B>Position</B></TD><TD><B>Type</B></TD></TR>
        <TR><TD>0</TD><TD>(18,14)</TD><TD>Task</TD></TR>
        <TR><TD>1</TD><TD>(18,4)</TD><TD>Task</TD></TR>
        <TR><TD>2</TD><TD>(10,10)</TD><TD>Task</TD></TR>
        <TR><TD>3</TD><TD>(5,3)</TD><TD>Task</TD></TR>
        <TR><TD>4</TD><TD>(5,10)</TD><TD>Task</TD></TR>
        <TR><TD>5</TD><TD>(5,15)</TD><TD>Task</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_robots {
    label="Robot Team & Capabilities";
    style=filled;
    fillcolor="#F0F8F0";
    color=black;

    team_info [shape=box, label="Team Size: 6 robots\n", fillcolor="#E8F8E8"];

    robot_caps [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3"><B>Robot Capabilities</B></TD></TR>
        <TR><TD><B>Robot ID</B></TD><TD><B>Name</B></TD><TD><B>Capabilities</B></TD></TR>
        <TR><TD>R1</TD><TD>Rover_1</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R2</TD><TD>Rover_2</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R3</TD><TD>Rover_3</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R4</TD><TD>Rover_4</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R5</TD><TD>Rover_5</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R6</TD><TD>Rover_6</TD><TD>Sensor_Camera</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_ltl {
    label="LTL Formula & Task Constraints";
    style=filled;
    fillcolor="#F8F0F0";
    color=black;

    ltl_info [shape=box, label="LTL Formula Details:\nAutomaton States: 61\nAccepting States: 8\n\n--- LTL FORMULA ---\nGF(p0 & X(!p1 U p2)) & GFp1 & Fp9 & Fp10 & (!p9 U p10) & Fp11 & (G(F(p4 & Xp0) & GF(p6 & Xp7)) | (GFp3 & GFp5 & GF(p12 & Xp13))) & Fp14", fillcolor="#F8E8E8"];

    ltl_tasks [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="5"><B>Task Requirements (LTL APs)</B></TD></TR>
        <TR><TD><B>AP ID</B></TD><TD><B>TS Region</B></TD><TD><B>Batch Value</B></TD><TD><B>Type</B></TD><TD><B>Required Capabilities</B></TD></TR>
        <TR><TD>AP0</TD><TD>TS0</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP1</TD><TD>TS1</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP2</TD><TD>TS2</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP3</TD><TD>TS3</TD><TD>0</TD><TD>Unrelated</TD><TD>Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP4</TD><TD>TS4</TD><TD>0</TD><TD>Unrelated</TD><TD>Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP5</TD><TD>TS5</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP6</TD><TD>TS2</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP7</TD><TD>TS4</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP9</TD><TD>TS3</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP10</TD><TD>TS1</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_GPS</TD></TR>
        <TR><TD>AP11</TD><TD>TS2</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP12</TD><TD>TS3</TD><TD>0</TD><TD>Unrelated</TD><TD>Sensor_Camera, Sensor_GPS</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_path {
    label="Optimal Execution Path";
    style=filled;
    fillcolor="#FFF8F0";
    color=darkred;
    penwidth=2;

    path_summary [shape=note, label="Optimal Path Summary\nTotal Steps: 20\nFinal Cost: 69\nTotal Execution Time: 398s\n", fillcolor="#FFFFCC", penwidth=2];

    opt_0 [shape=box, label="Step 0\nNBA: 0 | TS: 0\nCost: 0s | Total: 0s\n-----\nAllocated Robots:\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_1 [shape=box, label="Step 1\nNBA: 9 | TS: 1\nCost: 12s | Total: 24s\n-----\nAllocated Robots:\n  R4: 12s\n  R5: 12s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_2 [shape=box, label="Step 2\nNBA: 6 | TS: 3\nCost: 12s | Total: 48s\n-----\nAllocated Robots:\n  R1: 12s\n  R2: 12s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_3 [shape=box, label="Step 3\nNBA: 5 | TS: 2\nCost: 21s | Total: 87s\n-----\nAllocated Robots:\n  R1: 21s\n  R2: 21s\n  R6: 21s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_4 [shape=box, label="Step 4\nNBA: 2 | TS: 5\nCost: 28s | Total: 122s\n-----\nAllocated Robots:\n  R1: 28s\n  R3: 28s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_5 [shape=box, label="Step 5\nNBA: 15 | TS: 1\nCost: 28s | Total: 124s\n-----\nAllocated Robots:\n  R4: 13s\n  R5: 13s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_6 [shape=box, label="Step 6\nNBA: 16 | TS: 0\nCost: 28s | Total: 146s\n-----\nAllocated Robots:\n  R4: 24s\n  R5: 24s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_7 [shape=box, label="Step 7\nNBA: 29 | TS: 2\nCost: 32s | Total: 165s\n-----\nAllocated Robots:\n  R2: 32s\n  R4: 32s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_8 [shape=box, label="Step 8\nNBA: 31 | TS: 2\nCost: 33s | Total: 167s\n-----\nAllocated Robots:\n  R2: 33s\n  R4: 33s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_9 [shape=box, label="Step 9\nNBA: 51 | TS: 4\nCost: 38s | Total: 199s\n-----\nAllocated Robots:\n  R1: 38s\n  R2: 38s\n  R6: 38s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_10 [shape=box, label="Step 10\nNBA: 53 | TS: 4\nCost: 39s | Total: 211s\n-----\nAllocated Robots:\n  R1: 39s\n  R3: 39s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_11 [shape=box, label="Step 11\nNBA: 2 | TS: 0\nCost: 41s | Total: 236s\n-----\nAllocated Robots:\n  R4: 41s\n  R5: 41s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_12 [shape=box, label="Step 12\nNBA: 15 | TS: 1\nCost: 51s | Total: 259s\n-----\nAllocated Robots:\n  R2: 51s\n  R4: 51s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_13 [shape=box, label="Step 13\nNBA: 16 | TS: 0\nCost: 52s | Total: 283s\n-----\nAllocated Robots:\n  R1: 52s\n  R5: 52s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_14 [shape=box, label="Step 14\nNBA: 29 | TS: 2\nCost: 61s | Total: 302s\n-----\nAllocated Robots:\n  R1: 61s\n  R2: 61s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_15 [shape=box, label="Step 15\nNBA: 30 | TS: 0\nCost: 61s | Total: 321s\n-----\nAllocated Robots:\n  R4: 61s\n  R5: 61s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_16 [shape=box, label="Step 16\nNBA: 32 | TS: 2\nCost: 62s | Total: 323s\n-----\nAllocated Robots:\n  R1: 62s\n  R2: 62s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_17 [shape=box, label="Step 17\nNBA: 52 | TS: 4\nCost: 68s | Total: 365s\n-----\nAllocated Robots:\n  R1: 68s\n  R2: 68s\n  R6: 68s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_18 [shape=box, label="Step 18\nNBA: 54 | TS: 4\nCost: 69s | Total: 396s\n-----\nAllocated Robots:\n  R1: 69s\n  R3: 69s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_19 [shape=box, label="Step 19\nNBA: 2 | TS: 0\nCost: 69s | Total: 398s\n-----\nAllocated Robots:\n  R4: 62s\n  R5: 62s\n", fillcolor="#FF6B6B", penwidth=3, color=darkred, fontweight=bold, fontsize=11];

    opt_0 -> opt_1 [label="Δ=12s", penwidth=2, color=darkred];
    opt_1 -> opt_2 [label="Δ=0s", penwidth=2, color=darkred];
    opt_2 -> opt_3 [label="Δ=9s", penwidth=2, color=darkred];
    opt_3 -> opt_4 [label="Δ=7s", penwidth=2, color=darkred];
    opt_4 -> opt_5 [label="Δ=0s", penwidth=2, color=darkred];
    opt_5 -> opt_6 [label="Δ=0s", penwidth=2, color=darkred];
    opt_6 -> opt_7 [label="Δ=4s", penwidth=2, color=darkred];
    opt_7 -> opt_8 [label="Δ=1s", penwidth=2, color=darkred];
    opt_8 -> opt_9 [label="Δ=5s", penwidth=2, color=darkred];
    opt_9 -> opt_10 [label="Δ=1s", penwidth=2, color=darkred];
    opt_10 -> opt_11 [label="Δ=2s", penwidth=2, color=darkred];
    opt_11 -> opt_12 [label="Δ=10s", penwidth=2, color=darkred];
    opt_12 -> opt_13 [label="Δ=1s", penwidth=2, color=darkred];
    opt_13 -> opt_14 [label="Δ=9s", penwidth=2, color=darkred];
    opt_14 -> opt_15 [label="Δ=0s", penwidth=2, color=darkred];
    opt_15 -> opt_16 [label="Δ=1s", penwidth=2, color=darkred];
    opt_16 -> opt_17 [label="Δ=6s", penwidth=2, color=darkred];
    opt_17 -> opt_18 [label="Δ=1s", penwidth=2, color=darkred];
    opt_18 -> opt_19 [label="Δ=0s", penwidth=2, color=darkred];
  }

  // Connections between clusters
  env_info -> path_summary [style=dashed, color=gray, label="tasks"];
  team_info -> path_summary [style=dashed, color=gray, label="robots"];
  ltl_info -> path_summary [style=dashed, color=gray, label="constraints"];

}
