digraph ComprehensiveOptimalPath {
  rankdir=TB;
  concentrate=true;
  node [fontname=Arial];
  edge [fontname=Arial, fontsize=9];

  subgraph cluster_environment {
    label="Environment & Gridworld";
    style=filled;
    fillcolor="#F0F0F0";
    color=black;

    env_info [shape=box, label="GridWorld: 210x210\nTotal States: 6\nInitial State: 0\n", fillcolor="#E8F4F8"];

    env_tasks [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3"><B>Task Locations</B></TD></TR>
        <TR><TD><B>State ID</B></TD><TD><B>Position</B></TD><TD><B>Type</B></TD></TR>
        <TR><TD>0</TD><TD>(180,140)</TD><TD>Task</TD></TR>
        <TR><TD>1</TD><TD>(180,40)</TD><TD>Task</TD></TR>
        <TR><TD>2</TD><TD>(100,100)</TD><TD>Task</TD></TR>
        <TR><TD>3</TD><TD>(50,30)</TD><TD>Task</TD></TR>
        <TR><TD>4</TD><TD>(50,100)</TD><TD>Task</TD></TR>
        <TR><TD>5</TD><TD>(50,150)</TD><TD>Task</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_robots {
    label="Robot Team & Capabilities";
    style=filled;
    fillcolor="#F0F8F0";
    color=black;

    team_info [shape=box, label="Team Size: 45 robots\n", fillcolor="#E8F8E8"];

    robot_caps [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="3"><B>Robot Capabilities</B></TD></TR>
        <TR><TD><B>Robot ID</B></TD><TD><B>Name</B></TD><TD><B>Capabilities</B></TD></TR>
        <TR><TD>R1</TD><TD>Rover_1</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R2</TD><TD>Rover_2</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R3</TD><TD>Rover_3</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R4</TD><TD>Rover_4</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R5</TD><TD>Rover_5</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R6</TD><TD>Rover_6</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R7</TD><TD>Rover_7</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R8</TD><TD>Rover_8</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R9</TD><TD>Rover_9</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R10</TD><TD>Rover_10</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R11</TD><TD>Rover_11</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R12</TD><TD>Rover_12</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R13</TD><TD>Rover_13</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R14</TD><TD>Rover_14</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R15</TD><TD>Rover_15</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R16</TD><TD>Rover_16</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R17</TD><TD>Rover_17</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R18</TD><TD>Rover_18</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R19</TD><TD>Rover_19</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R20</TD><TD>Rover_20</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R21</TD><TD>Rover_21</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R22</TD><TD>Rover_22</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R23</TD><TD>Rover_23</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R24</TD><TD>Rover_24</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R25</TD><TD>Rover_25</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R26</TD><TD>Rover_26</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R27</TD><TD>Rover_27</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R28</TD><TD>Rover_28</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R29</TD><TD>Rover_29</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R30</TD><TD>Rover_30</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R31</TD><TD>Rover_31</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R32</TD><TD>Rover_32</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R33</TD><TD>Rover_33</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R34</TD><TD>Rover_34</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R35</TD><TD>Rover_35</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R36</TD><TD>Rover_36</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R37</TD><TD>Rover_37</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R38</TD><TD>Rover_38</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R39</TD><TD>Rover_39</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R40</TD><TD>Rover_40</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R41</TD><TD>Rover_41</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R42</TD><TD>Rover_42</TD><TD>Sensor_Camera</TD></TR>
        <TR><TD>R43</TD><TD>Rover_43</TD><TD>Sensor_GPS</TD></TR>
        <TR><TD>R44</TD><TD>Rover_44</TD><TD>Movement_Ground</TD></TR>
        <TR><TD>R45</TD><TD>Rover_45</TD><TD>Sensor_Camera</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_ltl {
    label="LTL Formula & Task Constraints";
    style=filled;
    fillcolor="#F8F0F0";
    color=black;

    ltl_info [shape=box, label="LTL Formula Details:\nAutomaton States: 61\nAccepting States: 8\n\n--- LTL FORMULA ---\nGF(p0 & X(!p1 U p2)) & GFp1 & Fp9 & Fp10 & (!p9 U p10) & Fp11 & (G(F(p4 & Xp0) & GF(p6 & Xp7)) | (GFp3 & GFp5 & GF(p12 & Xp13))) & Fp14", fillcolor="#F8E8E8"];

    ltl_tasks [shape=plaintext, label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
        <TR><TD COLSPAN="5"><B>Task Requirements (LTL APs)</B></TD></TR>
        <TR><TD><B>AP ID</B></TD><TD><B>TS Region</B></TD><TD><B>Batch Value</B></TD><TD><B>Type</B></TD><TD><B>Required Capabilities</B></TD></TR>
        <TR><TD>AP0</TD><TD>TS0</TD><TD>0</TD><TD>Unrelated</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP1</TD><TD>TS1</TD><TD>1</TD><TD>Compatible</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP2</TD><TD>TS2</TD><TD>1</TD><TD>Compatible</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP3</TD><TD>TS3</TD><TD>2</TD><TD>Compatible</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP4</TD><TD>TS4</TD><TD>2</TD><TD>Compatible</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP5</TD><TD>TS5</TD><TD>3</TD><TD>Compatible</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP6</TD><TD>TS0</TD><TD>4</TD><TD>Compatible</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP7</TD><TD>TS1</TD><TD>5</TD><TD>Compatible</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP9</TD><TD>TS3</TD><TD>6</TD><TD>Compatible</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP10</TD><TD>TS4</TD><TD>7</TD><TD>Compatible</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP11</TD><TD>TS5</TD><TD>4</TD><TD>Compatible</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
        <TR><TD>AP12</TD><TD>TS0</TD><TD>5</TD><TD>Compatible</TD><TD>Movement_Ground, Sensor_Camera, Sensor_GPS</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_path {
    label="Optimal Execution Path";
    style=filled;
    fillcolor="#FFF8F0";
    color=darkred;
    penwidth=2;

    path_summary [shape=note, label="Optimal Path Summary\nTotal Steps: 20\nFinal Cost: 1010\nTotal Execution Time: 7680s\n", fillcolor="#FFFFCC", penwidth=2];

    opt_0 [shape=box, label="Step 0\nNBA: 0 | TS: 0\nCost: 0s | Total: 0s\n-----\nAllocated Robots:\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_1 [shape=box, label="Step 1\nNBA: 9 | TS: 4\nCost: 85s | Total: 255s\n-----\nAllocated Robots:\n  R24: 85s\n  R25: 85s\n  R35: 85s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_2 [shape=box, label="Step 2\nNBA: 6 | TS: 3\nCost: 85s | Total: 348s\n-----\nAllocated Robots:\n  R1: 31s\n  R26: 31s\n  R36: 31s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_3 [shape=box, label="Step 3\nNBA: 5 | TS: 5\nCost: 218s | Total: 747s\n-----\nAllocated Robots:\n  R24: 218s\n  R25: 218s\n  R35: 218s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_4 [shape=box, label="Step 4\nNBA: 4 | TS: 2\nCost: 331s | Total: 1086s\n-----\nAllocated Robots:\n  R24: 331s\n  R25: 331s\n  R35: 331s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_5 [shape=box, label="Step 5\nNBA: 37 | TS: 1\nCost: 331s | Total: 1569s\n-----\nAllocated Robots:\n  R21: 161s\n  R29: 161s\n  R34: 161s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_6 [shape=box, label="Step 6\nNBA: 38 | TS: 0\nCost: 331s | Total: 2169s\n-----\nAllocated Robots:\n  R20: 200s\n  R27: 200s\n  R37: 200s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_7 [shape=box, label="Step 7\nNBA: 43 | TS: 2\nCost: 331s | Total: 2508s\n-----\nAllocated Robots:\n  R21: 274s\n  R29: 274s\n  R34: 274s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_8 [shape=box, label="Step 8\nNBA: 45 | TS: 0\nCost: 474s | Total: 3108s\n-----\nAllocated Robots:\n  R21: 474s\n  R29: 474s\n  R34: 474s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_9 [shape=box, label="Step 9\nNBA: 55 | TS: 1\nCost: 474s | Total: 3591s\n-----\nAllocated Robots:\n  R20: 361s\n  R27: 361s\n  R37: 361s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_10 [shape=box, label="Step 10\nNBA: 56 | TS: 5\nCost: 474s | Total: 3990s\n-----\nAllocated Robots:\n  R18: 133s\n  R19: 133s\n  R38: 133s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_11 [shape=box, label="Step 11\nNBA: 57 | TS: 3\nCost: 505s | Total: 4083s\n-----\nAllocated Robots:\n  R21: 505s\n  R29: 505s\n  R34: 505s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_12 [shape=box, label="Step 12\nNBA: 37 | TS: 1\nCost: 666s | Total: 4566s\n-----\nAllocated Robots:\n  R21: 666s\n  R29: 666s\n  R34: 666s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_13 [shape=box, label="Step 13\nNBA: 38 | TS: 0\nCost: 666s | Total: 5166s\n-----\nAllocated Robots:\n  R23: 200s\n  R43: 200s\n  R45: 200s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_14 [shape=box, label="Step 14\nNBA: 43 | TS: 2\nCost: 779s | Total: 5505s\n-----\nAllocated Robots:\n  R21: 779s\n  R29: 779s\n  R34: 779s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_15 [shape=box, label="Step 15\nNBA: 45 | TS: 0\nCost: 979s | Total: 6105s\n-----\nAllocated Robots:\n  R21: 979s\n  R29: 979s\n  R34: 979s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_16 [shape=box, label="Step 16\nNBA: 55 | TS: 1\nCost: 979s | Total: 6588s\n-----\nAllocated Robots:\n  R20: 522s\n  R27: 522s\n  R37: 522s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_17 [shape=box, label="Step 17\nNBA: 56 | TS: 5\nCost: 979s | Total: 6987s\n-----\nAllocated Robots:\n  R18: 266s\n  R19: 266s\n  R38: 266s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_18 [shape=box, label="Step 18\nNBA: 57 | TS: 3\nCost: 1010s | Total: 7080s\n-----\nAllocated Robots:\n  R21: 1010s\n  R29: 1010s\n  R34: 1010s\n", fillcolor="#B3E5FC", penwidth=1.5];
    opt_19 [shape=box, label="Step 19\nNBA: 4 | TS: 0\nCost: 1010s | Total: 7680s\n-----\nAllocated Robots:\n  R17: 200s\n  R30: 200s\n  R31: 200s\n", fillcolor="#FF6B6B", penwidth=3, color=darkred, fontweight=bold, fontsize=11];

    opt_0 -> opt_1 [label="Δ=85s", penwidth=2, color=darkred];
    opt_1 -> opt_2 [label="Δ=0s", penwidth=2, color=darkred];
    opt_2 -> opt_3 [label="Δ=133s", penwidth=2, color=darkred];
    opt_3 -> opt_4 [label="Δ=113s", penwidth=2, color=darkred];
    opt_4 -> opt_5 [label="Δ=0s", penwidth=2, color=darkred];
    opt_5 -> opt_6 [label="Δ=0s", penwidth=2, color=darkred];
    opt_6 -> opt_7 [label="Δ=0s", penwidth=2, color=darkred];
    opt_7 -> opt_8 [label="Δ=143s", penwidth=2, color=darkred];
    opt_8 -> opt_9 [label="Δ=0s", penwidth=2, color=darkred];
    opt_9 -> opt_10 [label="Δ=0s", penwidth=2, color=darkred];
    opt_10 -> opt_11 [label="Δ=31s", penwidth=2, color=darkred];
    opt_11 -> opt_12 [label="Δ=161s", penwidth=2, color=darkred];
    opt_12 -> opt_13 [label="Δ=0s", penwidth=2, color=darkred];
    opt_13 -> opt_14 [label="Δ=113s", penwidth=2, color=darkred];
    opt_14 -> opt_15 [label="Δ=200s", penwidth=2, color=darkred];
    opt_15 -> opt_16 [label="Δ=0s", penwidth=2, color=darkred];
    opt_16 -> opt_17 [label="Δ=0s", penwidth=2, color=darkred];
    opt_17 -> opt_18 [label="Δ=31s", penwidth=2, color=darkred];
    opt_18 -> opt_19 [label="Δ=0s", penwidth=2, color=darkred];
  }

  // Connections between clusters
  env_info -> path_summary [style=dashed, color=gray, label="tasks"];
  team_info -> path_summary [style=dashed, color=gray, label="robots"];
  ltl_info -> path_summary [style=dashed, color=gray, label="constraints"];

}
